# SQLite database file (created by scripts/seed_catalog.py)
DATABASE_URL=sqlite:///./data/bookstore.db

# HMAC key that signs the session cookie — use a random 32+ char value in production
SESSION_SECRET=change-me-in-production

# Local Ollama endpoint. Chat panel hides gracefully if unreachable.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Uvicorn bind
HOST=127.0.0.1
PORT=8000

# development | production. Production refuses to start with the default secret
# and marks the session cookie Secure.
ENV=development

# Agent budgets per chat turn (whichever is hit first ends the turn).
AGENT_MAX_ITERATIONS=10
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_SECONDS=120
AGENT_MAX_TOKENS=32000

# Messages of conversation memory replayed to the model.
CHAT_HISTORY_MAX_MESSAGES=30

# How long a checkout quote (and its locked prices) stays confirmable.
CHECKOUT_QUOTE_TTL_SECONDS=900

# MCP server: pin the cart this process acts on (default: a fresh cart per process).
# MCP_SESSION_ID=my-mcp-cart
